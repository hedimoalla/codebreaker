# Copy this file to .env and adjust as needed. Never put real secrets
# (API keys, signing credentials) in a file that gets committed — use
# .env.local (gitignored) or your CI provider's secret store for those.

# development | production
APP_ENV=development

# Real Steamworks AppID for this game. 480 is Valve's public test AppID,
# safe for local testing without a registered game (see steam/README.md).
STEAM_APP_ID=480

# true/false — see src/analytics.js for what this gates.
ANALYTICS_ENABLED=false

# true/false — see src/game.js MONETIZATION_CATALOG / purchase() for what
# this gates. Leave true until a real store SDK (Steamworks / StoreKit /
# Play Billing) is wired up.
IAP_SANDBOX=true
