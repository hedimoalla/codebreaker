# Local development defaults — no secrets belong in this file.
# Copied structure documented in .env.example.

APP_ENV=development

# Valve's public "Spacewar" test AppID. Replace with your real Steamworks
# AppID before distributing on Steam (see steam/README.md).
STEAM_APP_ID=480

# Analytics is off by default — see src/analytics.js. Flip to "true" once a
# real collector endpoint is wired up.
ANALYTICS_ENABLED=false

# In-app purchases run in a local simulation until a real store SDK is wired
# in (see src/game.js MONETIZATION_CATALOG / purchase()).
IAP_SANDBOX=true
