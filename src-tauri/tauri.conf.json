{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build",
    "devPath": "../www",
    "distDir": "../www"
  },
  "package": {
    "productName": "CodeBreaker",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "open": true }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.hedimoalla.codebreaker",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self';"
    },
    "windows": [
      {
        "title": "CodeBreaker",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 640,
        "resizable": true
      }
    ]
  }
}
